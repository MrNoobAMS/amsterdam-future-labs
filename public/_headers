# Cloudflare Pages cache policy.
# Hashed, content-addressed assets never change — cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font is stable — cache aggressively.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images can change between releases — cache a week, revalidate after.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800

# HTML: always revalidate so content updates ship immediately.
# Plus security hardening for every response:
#  - CSP: alles komt van de eigen origin; inline scripts/styles zijn nodig
#    (Astro inlinet CSS en de preloader/JSON-LD zijn inline scripts);
#    'wasm-unsafe-eval' is nodig voor de meshopt-decoder van het 3D-model.
#  - HSTS: dwing HTTPS af voor een jaar, inclusief subdomeinen.
#  - frame-ancestors/X-Frame-Options: voorkom clickjacking via iframes.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
